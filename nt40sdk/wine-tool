#!/bin/sh
# wine-tool TOOL ARGS...: run an NT 4.0 SDK or Visual C++ 4.2 tool (cl, link, nmake, rc,
# midl, ...) under Wine, looking in the SDK first like its SETENV. An absolute Unix path,
# alone or after an option (-Fo/abs, -I/abs, -out:/abs), becomes a Z: path. CPU, INCLUDE,
# LIB and WINEPATH come from the image; docker run -e changes them.
t=$1; shift
for b in ${MSTOOLS:-/opt/mstools}/bin ${MSDEV:-/opt/msdev}/bin; do
  e=$(ls "$b" | grep -i -x -m1 "$t\.exe") && break
done
[ -n "$e" ] || { echo "nt40sdk: no tool $t" >&2; exit 127; }
abs() { d=$(dirname "$1"); [ "$d" != / ] && [ -d "$d" ]; }
for a; do
  shift
  case $a in
  /*) if abs "$a"; then a="Z:$a"
      else p=$(printf '%s' "$a" | sed -nE 's#^/[A-Za-z]+:?(/.*)$#\1#p'); [ -n "$p" ] && abs "$p" && a="${a%"$p"}Z:$p"; fi ;;
  -*) p=$(printf '%s' "$a" | sed -nE 's#^-[A-Za-z]+:?(/.*)$#\1#p'); [ -n "$p" ] && abs "$p" && a="${a%"$p"}Z:$p" ;;
  esac
  set -- "$@" "$a"
done
export WINEDEBUG=${WINEDEBUG:--all}
exec wine "$b/$e" "$@"
