#!/bin/sh
# wine-tool TOOL ARGS...: run a Visual C++ 2.0 or NT 3.5 SDK tool (cl, link, nmake, rc,
# masm386, midl, ...) under Wine, looking in Visual C++ 2.0 first. An absolute Unix path,
# alone or after an option (-Fo/abs, -I/abs, -out:/abs), becomes a Z: path. CPU, INCLUDE,
# LIB and WINEPATH come from the image; docker run -e changes them.
t=$1; shift
for b in ${MSVC20:-/opt/msvc20}/bin ${MSTOOLS:-/opt/mstools}/bin; do
  e=$(ls "$b" | grep -i -x -m1 "$t\.exe") && break
done
[ -n "$e" ] || { echo "nt35sdk: no tool $t" >&2; exit 127; }
abs() { d=$(dirname "$1"); [ "$d" != / ] && [ -d "$d" ]; }
for a; do
  shift
  case $a in
  /*) if abs "$a"; then a="Z:$a"
      else p=$(printf '%s' "$a" | sed -nE 's#^/[A-Za-z]+:?(/.*)$#\1#p'); [ -n "$p" ] && abs "$p" && a="${a%"$p"}Z:$p"; fi ;;
  -*) p=$(printf '%s' "$a" | sed -nE 's#^-[A-Za-z]+:?(/.*)$#\1#p'); [ -n "$p" ] && abs "$p" && a="${a%"$p"}Z:$p" ;;
  esac
  set -- "$@" "$a"
done
export WINEDEBUG=${WINEDEBUG:--all}
exec wine "$b/$e" "$@"
